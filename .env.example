# Kopieren nach ".env" und mit echten Werten füllen.
# ".env" steht in .gitignore und wird NIE committed.

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Eigener Anthropic-API-Key von console.anthropic.com (pay-as-you-go,
# getrennt vom Claude-Pro-Abo). Wird auch für die ergänzende Websuche
# genutzt (Anthropics Web-Search-Tool) - kein separater Key nötig.
ANTHROPIC_API_KEY=
